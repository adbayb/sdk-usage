{
	"name": "@sdk-usage/plugin-javascript",
	"version": "0.1.0",
	"description": "Parser plugin for collecting imported JavaScript runtime usage.",
	"keywords": [
		"analyze",
		"analyzer",
		"api",
		"inspect",
		"javascript",
		"monitor",
		"scan",
		"usage"
	],
	"homepage": "https://github.com/adbayb/sdk-usage/tree/main/libraries/plugin-javascript#readme",
	"bugs": {
		"url": "https://github.com/adbayb/sdk-usage/issues"
	},
	"license": "MIT",
	"author": "Ayoub Adib <adbayb@gmail.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/adbayb/sdk-usage.git",
		"directory": "libraries/plugin-javascript"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "quickbundle build",
		"test": "vitest run",
		"watch": "quickbundle watch"
	},
	"devDependencies": {
		"@sdk-usage/core": "workspace:*",
		"@types/node": "26.6.6",
		"quickbundle": "3.2.2",
		"vitest": "5.1.0"
	},
	"peerDependencies": {
		"@sdk-usage/core": "^0.0.0 || <1.0.0"
	}
}
