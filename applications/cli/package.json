{
	"name": "@sdk-usage/cli",
	"version": "0.3.0",
	"description": "Command-line interface for scanning projects and collecting SDK usage as JSON.",
	"homepage": "https://github.com/adbayb/sdk-usage/tree/main/applications/cli#readme",
	"bugs": "https://github.com/adbayb/sdk-usage/issues",
	"license": "MIT",
	"author": "Ayoub Adib <adbayb@gmail.com> (https://twitter.com/adbayb)",
	"repository": {
		"type": "git",
		"url": "git@github.com:adbayb/sdk-usage.git",
		"directory": "applications/cli"
	},
	"bin": {
		"sdk-usage": "./bin/index.js"
	},
	"files": [
		"bin",
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "quickbundle build",
		"test": "vitest run",
		"watch": "quickbundle watch"
	},
	"dependencies": {
		"@sdk-usage/core": "workspace:^",
		"@sdk-usage/plugin-javascript": "workspace:^",
		"@sdk-usage/plugin-jsx": "workspace:^",
		"@sdk-usage/plugin-typescript": "workspace:^"
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"quickbundle": "3.2.2",
		"vitest": "5.1.0"
	},
	"engines": {
		"node": ">=22.5.0"
	}
}
